<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>5a3f2c41-9a2e-4c2d-9f4a-1d1a0f6b3c77</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>CompDataFlatbuffer</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Format.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)GraphIndexer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)CompositionSerializer.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated by build/RegenerateFlatbuffers.ps1 from source/LottieFlatbuffer/lottie_comp.fbs.
         Checked in so that contributors do not need flatc installed. -->
    <Compile Include="$(MSBuildThisFileDirectory)Generated\lottie_comp_generated.cs" />
  </ItemGroup>
</Project>
