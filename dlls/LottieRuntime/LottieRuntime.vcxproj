<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{6E0A5B4C-2F1D-4B7A-9C3E-1D5A8F0B2E47}</ProjectGuid>
    <RootNamespace>LottieRuntime</RootNamespace>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <WindowsTargetPlatformVersion>10.0.22621.0</WindowsTargetPlatformVersion>

    <!-- The interpreter targets the same minimum as the rest of Lottie-Windows.
         Anything newer is reached through the buffer's required UAP version, which
         a caller checks before it loads. -->
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PreprocessorDefinitions>LOTTIERUNTIME_EXPORTS;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);$(MSBuildThisFileDirectory)packages\flatbuffers\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>

      <!-- Exceptions are the error channel, and every interop entry point is
           noexcept, so there is nothing to unwind across an ABI boundary. -->
      <ExceptionHandling>Sync</ExceptionHandling>

      <!-- Size is the first thing this component optimizes for. -->
      <Optimization Condition="'$(Configuration)'=='Release'">MinSpace</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <StringPooling>true</StringPooling>
    </ClCompile>
    <Link>
      <AdditionalDependencies>d2d1.lib;dxguid.lib;windowsapp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <ModuleDefinitionFile>LottieRuntime.def</ModuleDefinitionFile>

      <!-- Discards the code for any node type the application never reaches. -->
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClInclude Include="LottieRuntime.h" />
    <ClInclude Include="LottieRuntimeCom.h" />
    <ClInclude Include="Generated\lottie_comp_generated.h" />
  </ItemGroup>

  <ItemGroup>
    <ClCompile Include="LottieRuntime.cpp" />
    <ClCompile Include="LottieRuntimeCom.cpp" />
  </ItemGroup>

  <ItemGroup>
    <!-- LottieRuntime.manifest is a private-assembly manifest, not embedded in
         this DLL: it is copied next to a consumer's exe (see
         LottieRuntimeComTest.vcxproj) and named directly by an ACTCTX, which is
         how CoCreateInstance resolves CLSID_LottieCompositionLoader without
         HKEY_CLASSES_ROOT registration or a linker-generated /MANIFEST, which
         would otherwise merge in a trustInfo/UAC block that only an application
         manifest is allowed to carry. -->
    <None Include="LottieRuntime.manifest" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <Link>
      <GenerateManifest>false</GenerateManifest>
    </Link>
  </ItemDefinitionGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
